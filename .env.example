# ==============================================================================
# IV CONNECT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel)
# ------------------------------------------------------------------------------
# Backend API Base URL (leave empty in local dev to use Vite proxy, or http://localhost:5000)
VITE_API_URL=http://localhost:5000

# Supabase Client Credentials (public anon key safe for browser)
# Obtain from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Node / Express / Railway)
# ------------------------------------------------------------------------------
PORT=5000
CORS_ORIGIN=http://localhost:5173,https://iv-management-system.vercel.app

# Supabase Admin Credentials (SERVER ONLY - NEVER SHARE WITH BROWSER OR PREFIX WITH VITE_)
# Obtain from Supabase Dashboard > Project Settings > API > service_role secret
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. ATTENDANCE MODULE (Backend + Frontend Public URL)
# ------------------------------------------------------------------------------
APP_PUBLIC_URL=https://iv-management-system.vercel.app
ATTENDANCE_DEFAULT_ROTATE_SECONDS=30
ATTENDANCE_SCAN_RATE_PER_MIN=10
