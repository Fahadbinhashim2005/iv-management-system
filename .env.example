# ==============================================================================
# IV CONNECT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configured in Vercel)
# ------------------------------------------------------------------------------
# Set this in Vercel Project Settings > Environment Variables:
# Replace with your actual Railway public domain (e.g., https://iv-webapp-production.up.railway.app)
VITE_API_URL=https://your-railway-app.up.railway.app

# Optional: Supabase Client Credentials for direct real-time database sync
# Find these in Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Configured in Railway)
# ------------------------------------------------------------------------------
# Port automatically assigned by Railway; defaults to 5000 locally
PORT=5000

# Optional: Supabase Service Role Key (if connecting server directly to Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
